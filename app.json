{
  "expo": {
    "name": "DTR Generator",
    "slug": "dtr-generator",
    "version": "1.0.1",
    "orientation": "portrait",
    "scheme": "dtr-generator",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.vergelvillaranda.dtrgenerator",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#F5F6F2",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6F2"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f999dd76-ec14-46a4-92a6-caccd9f3037c"
      }
    },
    "owner": "vergelvillaranda"
  }
}
